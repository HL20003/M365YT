{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "m365copilot-phuongchau-lab",
  "compatibility_date": "2026-09-01",
  // Worker kiểm tra đăng nhập (mật khẩu chung của lớp) trước khi trả nội dung trong public/
  // Mật khẩu: Secret LAB_PASSWORD (Cloudflare dashboard > Worker > Settings > Variables and Secrets)
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
